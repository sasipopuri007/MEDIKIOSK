# FastAPI Server Configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Security & Rate Limiting
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
RATE_LIMIT_OTP_PER_MINUTE=5

# Supabase Backend Service Role (NEVER EXPOSE TO FRONTEND)
SUPABASE_URL=https://your_supabase_project_id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Twilio Verify Service Credentials (NEVER EXPOSE TO FRONTEND)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# Google Maps / Places API Key (NEVER EXPOSE TO FRONTEND)
GOOGLE_MAPS_API_KEY=your_google_maps_places_api_key_here
